
    fn advance(&mut self, first: bool) -> Result<SmkFrameStatus, AssetsError> {
        if self.done {
            return Ok(SmkFrameStatus::Done);
        }
        if !first && self.index + 1 >= self.info.frames {
            self.done = true;
            return Ok(SmkFrameStatus::Done);
        }
        let dec = &mut self.dec;
        let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(move || {
            if first {
                dec.first_frame()
            } else {
                dec.next_frame()
            }
        }));
        let status = match outcome {
            Ok(Ok(s)) => s,
            Ok(Err(e)) => return Err(map_backend(e)),
            Err(_) => return Err(AssetsError::SmkDecode(PANICKED)),
        };
        self.index = if first { 0 } else { self.index + 1 };
        let out = match status {
            smk::FrameStatus::More => SmkFrameStatus::More,
            smk::FrameStatus::Last => SmkFrameStatus::Last,
            smk::FrameStatus::Done => SmkFrameStatus::Done,
        };
        if matches!(out, SmkFrameStatus::Last | SmkFrameStatus::Done)
            || self.index + 1 >= self.info.frames
        {
            self.done = true;
        }
        Ok(out)
    }

    /// Palette-indexed pixels of the current frame (width * height bytes).
    pub fn pixels(&self) -> &[u8] {
        self.dec.video_data()
    }

    /// Current palette. The backend expands the on-disk 6-bit components
    /// to 8-bit via the standard PALMAP table; quantizing back to 6-bit
    /// for the render canon is a presentation concern.
    pub fn palette(&self) -> &[[u8; 3]; 256] {
        self.dec.palette()
    }

    /// Decoded PCM bytes of the packet of `track` on the current frame:
    /// empty when the frame carries no data for the track, None for track
    /// indices >= 7.
    pub fn audio_packet(&self, track: u8) -> Option<&[u8]> {
        self.dec.audio_data(track)
    }

    /// Index of the current (most recently decoded) frame.
    pub fn frame_index(&self) -> u32 {
        self.index
    }
}
