//! TITLE.SMK asset gate (P4 Smacker spike; DECISIONS D30).
//!
//! Decodes the whole title video twice through the codec-neutral seam and
//! asserts the two runs are byte-identical: per-frame pixel+palette digests
//! and audio packet metadata/counts. Observed digests are printed so they
//! can be pinned as absolute constants once the backend is cross-validated
//! against libsmacker (deliberately NOT asserted yet - a backend upgrade
//! legitimately changes them).
//!
//! Corpus-skipping: silent skip when game-data is absent. Read-only.

use bedlam_assets::smk::{SmkStream, SmkYScale};
use sha2::{Digest, Sha256};
use std::fs;
use std::path::{Path, PathBuf};

fn title_path() -> PathBuf {
    Path::new(env!("CARGO_MANIFEST_DIR")).join("../../game-data/BEDLAM/GAMEGFX/TITLE.SMK")
}

#[derive(Debug, Clone, PartialEq, Eq)]
struct RunDigest {
    frames: usize,
    video_hex: String,
    audio_packets: usize,
    audio_bytes: usize,
    audio_hex: String,
}

fn decode_all(data: &[u8]) -> RunDigest {
    let mut s = SmkStream::open(data).expect("open TITLE.SMK");
    let (w, h) = (s.meta().width, s.meta().height);
    let mut video = Sha256::new();
    let mut audio = Sha256::new();
    let (mut frames, mut packets, mut audio_bytes) = (0usize, 0usize, 0usize);
    while let Some(f) = s.step().expect("decode step") {
        assert_eq!(f.index as usize, frames, "frame indices are sequential");
        assert_eq!(f.pixels.len(), (w * h) as usize);
        assert_eq!(f.palette.len(), 256);
        video.update(f.index.to_le_bytes());
        video.update(f.pixels);
        for entry in f.palette {
            video.update(entry);
        }
        for p in &f.audio {
            packets += 1;
            audio_bytes += p.data.len();
            audio.update(p.track.to_le_bytes());
            audio.update(p.data);
        }
        frames += 1;
    }
    RunDigest {
        frames,
        video_hex: hex(&video.finalize()),
        audio_packets: packets,
        audio_bytes,
        audio_hex: hex(&audio.finalize()),
    }
}

fn hex(b: &[u8]) -> String {
    b.iter().map(|x| format!("{:02x}", x)).collect()
}

#[test]
fn title_smk_gate() {
    let path = title_path();
    let data = match fs::read(&path) {
        Ok(d) => d,
        Err(_) => {
            eprintln!("{} absent, skipping", path.display());
            return;
        }
    };
    let meta = SmkStream::open(&data).expect("open").meta().clone();
    assert_eq!((meta.width, meta.height), (640, 320));
    assert_eq!(meta.frame_count, 1227);
    assert_eq!(meta.us_per_frame, 66_660); // raw -6666 x 10us = 15.0015 fps
    assert!(!meta.ring);
    assert_eq!(meta.y_scale, SmkYScale::None);
    assert_eq!(meta.audio_tracks.len(), 1);
    let t = &meta.audio_tracks[0];
    assert_eq!((t.track, t.channels, t.bit_depth, t.sample_rate), (0, 1, 8, 11_025));
    assert!(t.compressed); // DPCM in file; packets are decoded PCM
    drop(meta);
    let run1 = decode_all(&data);
    let run2 = decode_all(&data);
    assert_eq!(run1, run2, "two decode runs must be identical");
    assert_eq!(run1.frames, 1227);
    eprintln!(
        "TITLE.SMK gate: frames={} video={} packets={} audiobytes={} audio={}",
        run1.frames,
        run1.video_hex,
        run1.audio_packets,
        run1.audio_bytes,
        run1.audio_hex
    );
}
