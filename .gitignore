# All derived/decoded dumps from tools (copyrighted asset derivatives)
/derived/
# Golden reference media stays out of git; fingerprints are committed instead
/goldens/media/
*.iso
/target/
# Cargo.lock IS tracked (binary workspace -> reproducible builds)

# Local Ghidra project (large binaries)
/ghidra-project/
