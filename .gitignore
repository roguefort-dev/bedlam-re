# Reference game data (user-supplied original game; never redistributed)
/game-data/
# All derived/decoded dumps from tools (copyrighted asset derivatives)
/derived/
# Golden reference media stays out of git; fingerprints are committed instead
/goldens/media/
*.iso
/target/
# Cargo.lock IS tracked (binary workspace -> reproducible builds)

# Local Ghidra project (large binaries)
/ghidra-project/

# Third-party clones (references, not ours)
/tools/ghidra-ext/

# autonomy runtime state (NEXT.md/STATE.md ARE tracked)
/.state/heartbeat
/.state/*.log

# Bedlam 2 acquired data (IA msdos_Bedlam_2_-_Absolute_Bedlam_1997, CLASS rip 1997-11-02)
/game-data-2/
/MANIFEST-2.sha256
/derived-2/
# nudge runtime counters (incl. last-progress: last-commit marker)
/.state/fails
/.state/spawns
/.state/last-progress
/.state/STATUS.md
/.state/notified
/.state/claims/
/.state/concurrency
/.state/conc-degraded-at
/.state/last-spawn-ts
/.state/network-offline
/.state/network-last-recovery

# Pinned runtimes (flathub user-install + wine prefix) - see docs/RUNTIME.md
/runtime/

# Per-gate verdict cache for tools/validate-required-gates.py --gate-cache
# (D239: runtime accelerator, regenerable, never tracked evidence; no
# trailing slash so check-ignore matches before the directory exists)
/gate-cache
